# CitySense environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Django core ───────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=

# Comma-separated allowed hosts (no spaces)
# Example: localhost,127.0.0.1,citysense.example.com
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production / CI).  Leave empty to use SQLite for local dev.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ── AI ────────────────────────────────────────────────────────────────────────
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20

# Render build-time demo administrator bootstrap. Use a unique, strong password.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_NAME=
DEMO_ADMIN_PASSWORD=
